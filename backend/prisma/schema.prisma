generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String?
  name             String
  authProvider     String          @default("local")
  googleId         String?         @unique
  profileImage     String?
  role             Role            @default(CLUB)
  isVerified       Boolean         @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  clubProfile      ClubProfile?
  companyProfile   CompanyProfile?
  notifications    Notification[]
}

enum Role {
  CLUB
  COMPANY
  ADMIN
}

model ClubProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeName       String
  description       String?
  profilePhoto      String?
  about             String?
  pastEvents        String?
  reach             Int      @default(0)
  socialLinks       String?
  contactPerson     String?
  contactNumber     String?
  website           String?
  totalAmountRaised Float    @default(0)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  events            Event[]

  @@index([userId])
}

model CompanyProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry         String?
  about            String?
  budgetRange      String?
  targetAudience   String?
  companySize      String?
  website          String?
  contactPerson    String?
  contactNumber    String?
  socialLinks      String?
  totalAmountSpent Float             @default(0)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deals            SponsorshipDeal[]

  @@index([userId])
}

model Event {
  id          String            @id @default(uuid())
  clubId      String
  club        ClubProfile       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name        String
  description String
  eventType   String
  footfall    Int               @default(0)
  location    String
  date        DateTime
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tiers       SponsorshipTier[]
  deals       SponsorshipDeal[]

  @@index([clubId])
  @@index([date])
}

model SponsorshipTier {
  id        String            @id @default(uuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  amount    Float
  benefits  String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deals     SponsorshipDeal[]

  @@index([eventId])
}

model SponsorshipDeal {
  id              String          @id @default(uuid())
  eventId         String
  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  companyId       String
  company         CompanyProfile  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tierId          String
  tier            SponsorshipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  status          DealStatus      @default(PENDING)
  paymentStatus   PaymentStatus   @default(UNPAID)
  dealPin         String?
  negotiationNotes String?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  activityLogs    ActivityLog[]

  @@index([eventId])
  @@index([companyId])
  @@index([tierId])
  @@index([status])
}

enum DealStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

model ActivityLog {
  id        String          @id @default(uuid())
  dealId    String
  deal      SponsorshipDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  actorId   String
  createdAt DateTime        @default(now())

  @@index([dealId])
  @@index([actorId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
