# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sponsorbridge

# JWT
JWT_SECRET=your-secure-jwt-secret-min-32-chars-long-here
JWT_REFRESH_SECRET=your-secure-refresh-secret-min-32-chars-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin
ADMIN_SECRET=your-admin-registration-secret

# CSRF
CSRF_SECRET=your-secure-csrf-secret-min-32-chars-here

# CORS
CORS_ORIGIN=http://localhost:3000
